{
  "schema_version": 1,
  "name": "retention_pressure",
  "description": "Bounded event and side-list retention should prune fixture-generated module updates inside temporary memory only.",
  "runtime": {
    "profile": "safe_demo",
    "memory_is_temporary": true,
    "context_max_events": 30,
    "protected_recent_events": 10,
    "side_list_default_max_entries": 20,
    "max_ticks": 1
  },
  "inputs": [
    {
      "tick": 1,
      "source": "scenario_retention_pressure",
      "kind": "module_update_burst",
      "patterns": ["module_update_fixture"],
      "activation": 1.0,
      "payload": {"count": 80}
    }
  ],
  "expect": {
    "required_markers": [2],
    "forbidden_markers": [17, 20],
    "marker_order": [],
    "memory_unchanged": true,
    "retention_pruned_events": true,
    "side_list_caps_respected": true
  }
}
